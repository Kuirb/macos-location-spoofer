.DS_Store

# Personal target coordinates and locally generated modules
macos-shadowrocket/location.conf
macos-shadowrocket/generated/

# Never publish locally generated HTTPS interception certificates or keys
*.crt
*.cer
*.pem
*.key
*.p12
*.pfx
*.der
*.mobileconfig

# Local environment files can contain credentials; keep the documented example.
.env
.env.*
!.env.example

# Diagnostics
*.log
